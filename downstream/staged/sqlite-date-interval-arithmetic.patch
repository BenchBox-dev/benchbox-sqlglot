+    def _unsafe_interval_base(self, base: exp.Expr, typed: exp.Expr, unit: str) -> bool:
+        if typed.is_type(exp.DType.TIMESTAMPTZ, exp.DType.TIMESTAMPLTZ):
+            return True
+        if unit in ("HOUR", "MINUTE", "SECOND"):
+            return False
+        if not typed.is_type(*exp.DataType.TEMPORAL_TYPES):
+            return True
+        if unit not in ("MONTH", "QUARTER", "YEAR"):
+            return False
+        literal = base.this if isinstance(base, (exp.Cast, exp.Date)) else base
+        if isinstance(literal, exp.Null):
+            return False
+        match = literal.is_string and re.fullmatch(
+            r"\d{1,4}-\d{1,2}-(\d{1,2})(?:[ T].*)?", literal.name.strip()
+        )
+        return not match or int(match.group(1)) > 28
+
+    def _date_interval_sql(self, expression: exp.Add | exp.Sub) -> str | None:
+        from sqlglot.optimizer.annotate_types import annotate_types
+
+        base, interval = expression.this, expression.expression
+        if isinstance(expression, exp.Add) and isinstance(base, exp.Interval):
+            base, interval = interval, base
+        if not (isinstance(interval, exp.Interval) and interval.unit):
+            return None
+        unit = interval.unit.name.upper().removesuffix("S")
+        typed = annotate_types(base.copy(), dialect=self.dialect, overwrite_types=False)
+        if self._unsafe_interval_base(base, typed, unit):
+            return None
+        if unit not in ("HOUR", "MINUTE", "SECOND") and typed.is_type(exp.DType.DATE):
+            expression = expression.__class__(this=base.copy(), expression=interval.copy())
+        return self._date_delta_sql(expression, base, interval)
+
+    def add_sql(self, expression: exp.Add) -> str:
+        return self._date_interval_sql(expression) or super().add_sql(expression)
+
+    def sub_sql(self, expression: exp.Sub) -> str:
+        return self._date_interval_sql(expression) or super().sub_sql(expression)
+
+    def interval_sql(self, expression: exp.Interval) -> str:
+        self.unsupported("SQLite does not support this INTERVAL expression")
+        return super().interval_sql(expression)
+
     def cast_sql(self, expression: exp.Cast, safe_prefix: str | None = None) -> str:
         if expression.is_type("date"):
             return self.func("DATE", expression.this)
