+    def test_date_interval_guards(self):
+        self.validate_all(
+            "SELECT DATE(DATE('2024-01-31'), '30 DAYS'), DATE(DATE('2024-01-15'), '1 MONTH')",
+            read={
+                "postgres": "SELECT DATE '2024-01-31' + INTERVAL '30 days', "
+                "DATE '2024-01-15' + INTERVAL '1 month'"
+            },
+        )
+        self.assertEqual(
+            annotate_types(
+                parse_one("SELECT DATE '2024-01-31' - INTERVAL '30 days'", read="postgres"),
+                dialect="postgres",
+            ).sql("sqlite"),
+            "SELECT DATE(DATE('2024-01-31'), '-30 DAYS')",
+        )
+        for read, source in (
+            ("postgres", "DATE '2024-01-31' + INTERVAL '1 month'"),
+            ("postgres", "DATE '2024-02-29' - INTERVAL '1 year'"),
+            ("postgres", "CAST(d AS DATE) + INTERVAL '1 month'"),
+            ("postgres", "d + INTERVAL '1 day'"),
+            ("mysql", "CAST(x AS TIMESTAMP) + INTERVAL 1 DAY"),
+        ):
+            with self.subTest(source=source), self.assertRaises(UnsupportedError):
+                parse_one(source, read=read).sql("sqlite", unsupported_level=ErrorLevel.RAISE)
+
+    def test_date_interval_guards_execution(self):
