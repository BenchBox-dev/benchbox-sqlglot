+                ("SELECT DATE '2024-02-28' + INTERVAL '1 year'", "2025-02-28"),
+                (
+                    "SELECT TIMESTAMP '2024-01-15 23:30:00' + INTERVAL '1 day'",
+                    "2024-01-16 23:30:00",
