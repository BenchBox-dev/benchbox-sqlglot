+    def cosinesimilarity_sql(self, expression: exp.CosineSimilarity) -> str:
+        # SingleStore has DOT_PRODUCT but no cosine function: dot(a, b) / (|a| * |b|), NULL for a zero vector
+        this, other = expression.this, expression.expression
