 from __future__ import annotations
 
+import re
 import typing as t
 from collections import defaultdict
 
@@ -42,6 +43,52 @@ if t.TYPE_CHECKING:
     from sqlglot._typing import E
 
 
+_NAMED_GROUP = re.compile(r"\(\?(?:P?<[A-Za-z_]|')")
+_GROUP_REFERENCE = re.compile(r"\\(\\|\d)")
+
+
+def _capture_non_capturing_groups(pattern: str) -> tuple[str, dict[int, int]] | None:
+    result: list[str] = []
+    groups: dict[int, int] = {}
+    original = captured = 0
+    converted = False
+    in_class = False
+    i = 0
+    while i < len(pattern):
+        char = pattern[i]
+        if char == "\\":
+            result.append(pattern[i : i + 2])
+            i += 2
+        elif in_class:
+            in_class = char != "]"
+            result.append(char)
+            i += 1
+        elif char == "[":
+            end = i + 1
+            if pattern.startswith("^", end):
+                end += 1
+            if pattern.startswith("]", end):
+                end += 1
+            result.append(pattern[i:end])
+            in_class = True
+            i = end
+        elif pattern.startswith("(?:", i):
+            captured += 1
+            converted = True
+            result.append("(")
+            i += 3
+        elif char == "(" and (not pattern.startswith("(?", i) or _NAMED_GROUP.match(pattern, i)):
+            original += 1
+            captured += 1
+            groups[original] = captured
+            result.append(char)
+            i += 1
+        else:
+            result.append(char)
+            i += 1
+    return ("".join(result), groups) if converted else None
+
