diff --git a/sqlglot/generator.py b/sqlglot/generator.py
index 54ae4130..df3063aa 100644
--- a/sqlglot/generator.py
+++ b/sqlglot/generator.py
@@ -361,6 +361,9 @@ class Generator:
     # Whether GROUPING SETS can follow GROUP BY expressions without a comma
     SUPPORTS_GROUPING_SETS_AS_SUFFIX = False
 
+    # Whether GROUP BY () is accepted
+    SUPPORTS_EMPTY_GROUP_BY = True
+
     # The string used for creating an index on a table
     INDEX_ON = "ON"
 
@@ -2877,7 +2880,31 @@ class Generator:
         expressions = self.expressions(expression, indent=False)
         return f"CUBE {self.wrap(expressions)}" if expressions else "WITH CUBE"
 
+    def _is_droppable_empty_group_by(self, expression: exp.Group) -> bool:
+        select = expression.parent
+        only = expression.expressions[0] if len(expression.expressions) == 1 else None
+        if (
+            not isinstance(select, exp.Select)
+            or not isinstance(only, exp.Tuple)
+            or only.expressions
+            or any(
+                expression.args.get(key) for key in ("grouping_sets", "cube", "rollup", "totals")
+            )
+        ):
+            return False
+        return bool(select.args.get("having")) or any(
+            not isinstance(aggregate.parent, exp.Window)
+            for projection in select.expressions
+            for aggregate in projection.find_all(exp.AggFunc)
+        )
+
     def group_sql(self, expression: exp.Group) -> str:
+        if not self.SUPPORTS_EMPTY_GROUP_BY:
+            if self._is_droppable_empty_group_by(expression):
+                return ""
+            if any(isinstance(e, exp.Tuple) and not e.expressions for e in expression.expressions):
+                self.unsupported("GROUP BY () is not supported")
+
         group_by_all = expression.args.get("all")
         if group_by_all is True:
             modifier = " ALL"
